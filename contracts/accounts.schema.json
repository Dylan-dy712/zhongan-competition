{
  "SessionResponse": {
    "$defs": {
      "AccountUser": {
        "additionalProperties": false,
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          }
