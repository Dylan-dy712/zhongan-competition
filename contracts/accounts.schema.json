        "title": "AccountUser",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "account-v1",
        "default": "account-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "access_token": {
        "title": "Access Token",
        "type": "string"
      },
      "token_type": {
        "const": "bearer",
        "default": "bearer",
        "title": "Token Type",
        "type": "string"
      },
      "expires_at": {
        "format": "date-time",
        "title": "Expires At",
        "type": "string"
      },
      "user": {
        "$ref": "#/$defs/AccountUser"
      }
    },
    "required": [
      "access_token",
      "expires_at",
      "user"
    ],
    "title": "SessionResponse",
    "type": "object"
  },
  "ConsentResponse": {
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "account-consent-v1",
        "default": "account-consent-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "subject_id": {
        "format": "uuid",
