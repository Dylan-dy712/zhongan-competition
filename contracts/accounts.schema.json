        "title": "Consent Id"
      },
      "version": {
        "title": "Version",
        "type": "integer"
      },
      "status": {
        "enum": [
          "active",
          "revoked",
          "expired",
          "not_granted"
        ],
        "title": "Status",
        "type": "string"
      },
      "notice_version": {
        "title": "Notice Version",
        "type": "string"
      },
      "purpose": {
        "const": "case_guidance",
        "title": "Purpose",
        "type": "string"
      }
    },
    "required": [
      "subject_id",
      "consent_id",
      "version",
      "status",
      "notice_version",
      "purpose"
    ],
    "title": "ConsentResponse",
    "type": "object"
  },
